# ─────────────────────────────────────────────────────────────────
# STOP & SHOP — ENVIRONMENT VARIABLES DOCUMENTATION
# ─────────────────────────────────────────────────────────────────

# ── Database & Core ──
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stopshop?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5001

# ── Site & Domain ──
NEXT_PUBLIC_SITE_URL=https://stop-shop-gamma.vercel.app

# ── Search Engine Verification (Google Search Console & Bing Webmaster) ──
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token-here
NEXT_PUBLIC_BING_SITE_VERIFICATION=bing-site-verification-token-here

# ── Admin Credentials ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ── Cloudinary Media Delivery ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Transactional Email (Resend) ──
RESEND_API_KEY=re_your_resend_key_here

# ── Redis / Upstash Distributed Caching ──
KV_REST_API_URL=https://your-upstash-endpoint.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
KV_REST_API_READ_ONLY_TOKEN=your_upstash_read_token
REDIS_URL=rediss://default:your_token@your-upstash-endpoint.upstash.io:6379

# ── Analytics & Tracking (Optional) ──
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_PIXEL_ID=1234567890
